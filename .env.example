# ============================================================
#  HERZLIED — Umgebungsvariablen
#  Kopiere diese Datei zu ".env.local" und trage deine Werte ein.
# ============================================================

# --- Öffentliche Basis-URL deiner Seite (ohne Slash am Ende) ---
# Lokal:    http://localhost:3000
# Live:     https://herzlied.de
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================================
#  STRIPE  (Zahlungen)   ->  https://dashboard.stripe.com/apikeys
# ============================================================
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook-Signing-Secret (siehe README, Schritt "Stripe Webhook")
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ============================================================
#  ELEVENLABS  (Song-Generierung)  ->  https://elevenlabs.io/app/settings/api-keys
#  Hinweis: Für den kommerziellen Verkauf brauchst du einen
#  BEZAHLTEN Plan (ab "Starter"), der die kommerzielle Lizenz enthält.
# ============================================================
ELEVENLABS_API_KEY=xi_xxx
# Modell: music_v2 (empfohlen, beste Qualität) oder music_v1
ELEVENLABS_MODEL=music_v2

# ============================================================
#  OPENAI  (optional, aber empfohlen — schreibt die persönlichen
#  Songtexte. Ohne Key schreibt ElevenLabs die Lyrics selbst.)
#  ->  https://platform.openai.com/api-keys
# ============================================================
OPENAI_API_KEY=sk-xxx

# ============================================================
#  E-MAIL-VERSAND (SMTP, z. B. Brevo)  ->  https://app.brevo.com/settings/keys/smtp
# ============================================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=dein-brevo-login
SMTP_PASS=dein-brevo-smtp-key
# Absender, der beim Empfänger erscheint:
SMTP_FROM=Herzlied <hallo@herzlied.de>
